# Copy to .env.local for local development. Never commit real values.

# Public site URL, used for canonical/Open Graph URLs, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://nuvakin.com

# Optional public contact details shown in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=office@nuvakin.com
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/your-page

# Server-only. The Google Apps Script web app URL (ends in /exec) and the shared
# secret stored in that script's properties as WAITLIST_SECRET.
# See docs/GOOGLE_SHEETS_SETUP.md. For local testing with the mock endpoint:
#   WAITLIST_ENDPOINT_URL=http://localhost:8787
#   WAITLIST_SHARED_SECRET=dev-secret
WAITLIST_ENDPOINT_URL=
WAITLIST_SHARED_SECRET=
